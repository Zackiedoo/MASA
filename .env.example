# ───────── Client (exposed to the browser — safe, these are public identifiers) ─────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Student IDs are mapped to a synthetic e-mail for Firebase Auth. Must equal LOGIN_EMAIL_DOMAIN below.
VITE_LOGIN_EMAIL_DOMAIN=masa-login.example.com

# ───────── Server only (Vercel functions in /api — NEVER prefix with VITE_) ─────────
# Entire service-account JSON from Firebase Console → Project settings → Service accounts, on ONE line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=
LOGIN_EMAIL_DOMAIN=masa-login.example.com
# Shared secret for the memorandum webhook (header: x-masa-webhook-secret). Leave empty to disable the webhook.
MEMO_WEBHOOK_SECRET=
# Secret for /api/cron/cleanup (Vercel sends it automatically as a Bearer token).
CRON_SECRET=
